#!/bin/sh
# Pre-commit: secrets and personal data in the staged change, and the comment rule on staged sources.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

fail=0
python3 scripts/publish-check.py --staged || fail=1

sources=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(kt|kts|swift)$')
if [ -n "$sources" ]; then
    printf '%s\n' "$sources" | xargs python3 scripts/comment-check.py || fail=1
fi

exit "$fail"
